<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HealthTrackerL00184357.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HealthTrackerL00184357.Views"
    xmlns:local="clr-namespace:HealthTrackerL00184357"
    Title="HealthTrackerL00184357">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <TabBar>

        <ShellContent Title="Home" ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
        <ShellContent Title="Health" ContentTemplate="{DataTemplate views:MeasurementsPage}" />
        <ShellContent Title="Activity" ContentTemplate="{DataTemplate views:ActivityPage}" />
        <ShellContent Title="Goals" ContentTemplate="{DataTemplate views:GoalsPage}" />
        <ShellContent Title="Trends" ContentTemplate="{DataTemplate views:StatisticsPage}" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />

    </TabBar>

</Shell>
